{
  "name": "newmaybe-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:main": "ASTRO_TELEMETRY_DISABLED=1 npm run dev -w apps/main",
    "dev:graph": "ASTRO_TELEMETRY_DISABLED=1 npm run dev -w apps/graph",
    "dev:ai": "npm run dev -w apps/ai",
    "dev:lab": "ASTRO_TELEMETRY_DISABLED=1 npm run dev -w apps/lab",
    "dev:studio": "npm run dev -w apps/studio",
    "dev:study": "npm run dev -w apps/study",
    "dev:club": "npm run dev -w apps/club",
    "build:main": "ASTRO_TELEMETRY_DISABLED=1 npm run build -w apps/main",
    "build:graph": "ASTRO_TELEMETRY_DISABLED=1 npm run build -w apps/graph",
    "build:ai": "npm run build -w apps/ai",
    "build:lab": "ASTRO_TELEMETRY_DISABLED=1 npm run build -w apps/lab",
    "build:studio": "npm run build -w apps/studio",
    "build:study": "npm run build -w apps/study",
    "build:club": "npm run build -w apps/club",
    "audit": "tsx scripts/audit-posts.ts",
    "new": "tsx scripts/new.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "tokens:build": "node --import tsx scripts/generate-tokens.ts",
    "tokens:check": "node --import tsx scripts/generate-tokens.ts --check",
    "test:e2e": "playwright test",
    "budget": "node --import tsx scripts/check-budgets.ts",
    "affected": "node --import tsx scripts/affected-apps.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{astro,css,md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
