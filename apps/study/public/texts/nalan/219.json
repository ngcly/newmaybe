{
  "title": "咏柳",
  "paras": [
    ["三眠未歇，乍到秋时节。", "一树斜阳蝉更咽，曾绾灞陵离别。", "絮已为萍风卷叶，空凄切。"],
    [
      "长条莫轻折。",
      "苏小恨，倩他说。",
      "尽飘零、游冶章台客。",
      "红板桥空，湔裙人去，依旧晓风残月。"
    ]
  ],
  "author": "纳兰性德",
  "layout": {
    "type": "poetry",
    "watermark": "bamboo",
    "writingMode": "vertical"
  }
}
