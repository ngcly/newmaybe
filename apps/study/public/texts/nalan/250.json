{
  "title": "上元",
  "paras": [
    [
      "阑珊火树鱼龙舞，望中宝钗楼远。",
      "靺鞨余红，琉璃剩碧，待属花归缓缓。",
      "寒轻漏浅。",
      "正乍敛烟霏，陨星如箭。",
      "旧事惊心，一双莲影藕丝断。"
    ],
    [
      "莫恨流年似水，恨消残蝶粉，韶光忒贱。",
      "细语吹香，暗尘笼鬓，都逐晓风零乱。",
      "阑干敲遍。",
      "问帘底纤纤，甚时重见？",
      "不解相思，月华今夜满。"
    ]
  ],
  "author": "纳兰性德",
  "layout": {
    "type": "poetry",
    "watermark": "bamboo",
    "writingMode": "vertical"
  }
}
