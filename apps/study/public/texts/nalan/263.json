{
  "title": "又",
  "paras": [
    [
      "生怕芳尊满。",
      "到更深、迷离醉影，残灯相伴。",
      "依旧回廊新月在，不定竹声撩乱。",
      "问愁与、春宵长短。",
      "燕子楼空弦索冷，任梨花、落尽无人管。",
      "谁领略，真真唤。"
    ],
    [
      "此情拟倩东风浣。",
      "奈吹来、余香病酒，旋添一半。",
      "惜别江淹消瘦了，怎耐轻寒轻暖。",
      "忆絮语、纵横名碗。",
      "滴滴西窗红蜡泪，那时肠、早为而今断。",
      "任角枕，欹孤馆。"
    ]
  ],
  "author": "纳兰性德",
  "layout": {
    "type": "poetry",
    "watermark": "bamboo",
    "writingMode": "vertical"
  }
}
