{
  "title": "梁东宫行雨山铭",
  "paras": [
    ["山名行雨，地异阳台。"],
    ["佳人无数，神女看来。"],
    ["翠幔朝开，新妆旦起。"],
    ["树入床头，花来镜里。"],
    ["草绿衫同，花红面似。"],
    ["开年寒尽，正月游春。"],
    ["俱除锦帔，并脱红纶。"],
    ["天丝剧蕅，蜨粉生尘。"],
    ["横藤碍路，弱柳低人。"],
    ["谁言洛浦，一个河神。"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
