{
  "title": "镫赋",
  "paras": [
    ["九龙将暝，三爵行栖。"],
    ["琼钩半上，若木全低。"],
    ["窗藏明于粉壁，柳助暗于兰闺。"],
    ["翡翠珠被，流苏羽帐。"],
    ["舒屈膝之屏风，掩芙蓉之行障。"],
    ["卷衣秦后之床，送枕荆台之上。"],
    ["乃有百枝同树，四照连盘。"],
    ["香添然蜜，气襍烧兰。"],
    ["烬长宵久，光青夜寒。"],
    ["秀华掩映，蚖膏照灼。"],
    ["动鳞甲于鲸鱼，燄光𦬆于鸣鹤。"],
    ["蛾飘则碎花乱下，风起则流星细落。"],
    ["况复上兰深夜，中山醑清。"],
    ["楚妃留客，韩娥合声。"],
    ["低謌著节，游弦绝鸣。"],
    ["辉辉朱烬，燄燄红荣。"],
    ["乍九光而连彩，或双花而竝明。"],
    ["寄言苏季子，应知余照情。"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
