{
  "title": "团扇铭",
  "paras": [
    ["武王元览，造扇于前。"],
    ["班生赡博，白绮仍传。"],
    ["裁筠比雾，裂素轻蝉。"],
    ["片月内掩，重规外圆。"],
    ["炎隆火正，石铄沙煎。"],
    ["清逾苹末，莹等寒泉。"],
    ["恩深难恃，爱极则迁。"],
    ["秋风飒至，箧笥长捐。"],
    ["勒铭华扇，敢荐夏筵。"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
