{
  "title": "丽人赋",
  "paras": [
    ["有客弱冠未仕，缔交戚里，驰骛王室，遨游许史。"],
    ["归而称曰：狭邪才女，铜街丽人。"],
    ["亭亭似月，嬿婉如春。"],
    ["凝情待价，思尚衣巾。"],
    ["芳逾散麝，色茂开莲。"],
    ["陆离羽佩，襍错花钿。"],
    ["响罗衣而不进，隐明镫而未前。"],
    ["中步檐而一息，顺长廊而迥归。"],
    ["池翻荷而纳影，风动竹而吹衣。"],
    ["薄草延伫，宵分乃至。"],
    ["出暗入光，含羞隐媚。"],
    ["垂罗曳锦，鸣瑶动翠。"],
    ["来脱薄妆，去留余腻。"],
    ["沾粉委露，理鬓清渠。"],
    ["落花入领，微风动裾。"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
