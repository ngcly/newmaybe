{
  "title": "杕杜",
  "paras": [
    [
      "有杕之杜，其叶湑湑。",
      "独行踽踽。",
      "岂无他人？",
      "不如我同父。",
      "嗟行之人，胡不比焉？",
      "人无兄弟，胡不佽焉？"
    ],
    [
      "有杕之杜，其叶箐箐。",
      "独行睘睘。",
      "岂无他人？",
      "不如我同姓。",
      "嗟行之人，胡不比焉？",
      "人无兄弟，胡不佽焉？"
    ]
  ],
  "layout": {
    "type": "poetry",
    "watermark": "bamboo",
    "writingMode": "vertical"
  }
}
