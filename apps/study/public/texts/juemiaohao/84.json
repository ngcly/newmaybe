{
  "title": "",
  "paras": [
    ["东风吹梦落巫山。", "整云鬟，却霜纨。", "雪貌冰肤，曾共控双鸾。"],
    ["吹罢玉箫香雾湿，残月坠，乱峰寒。"],
    ["解珰回首忆前欢。", "见无缘，恨无端。", "惟悴萧郎，赢得带围宽。"],
    ["红叶不传天上信，空流水，到人间。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "姜夔",
  "tune": "江神子"
}
