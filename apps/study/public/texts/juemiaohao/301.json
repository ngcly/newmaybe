  "paras": [
    ["宿酲苏，春梦醒，沉水冷金鸭。", "落尽桃花，无人扫红雪。"],
    ["渐催煮酒园林，单衣庭院，春又到断肠时节。"],
    ["恨离别。", "长忆人立荼蘼，珠帘卷香月。", "几度黄昏，琼枝为谁折。"],
    ["都将千里芳心，十年幽梦，分付与、一声啼鷢。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "吴文英",
  "tune": "祝英台近"
