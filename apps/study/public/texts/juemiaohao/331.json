{
  "title": "",
  "paras": [
    ["杏花初，梅花过，时节又春半。", "帘影飞梭，轻阴小庭院。"],
    ["旧时月底秋千，吟香醉玉，曾细听、歌珠一串。"],
    ["忍重见，描金小字题情，生绡合欢扇。", "老了刘郎，天远玉箫伴。"],
    ["几番莺外斜阳，栏杆倚遍。", "恨杨花、遮愁不断。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "刘澜",
  "tune": "祝英台近"
}
