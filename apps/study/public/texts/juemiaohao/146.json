  "paras": [
    ["萼绿华身，小桃花扇，安石榴裙。", "子野闻歌，周郎顾曲，曾恼夫君。"],
    ["悠悠羁旅愁人。", "似零落、青天断云。", "何处销魂？", "初三夜月，第四桥春。"],
    ["。", "岳工于四六骈体，亦善诗词。", "有《秋崖集》传世。", "生平事迹见《秋崖小稿》卷首载"],
    ["洪焱祖《秋崖先生传》。"]
  ],
