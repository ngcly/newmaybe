{
  "title": "",
  "paras": [
    ["紫云暖，恨翠雏、珠树双栖晚。", "小花静院逢迎，的的风流心眼。"],
    ["化潮照玉碗。", "午香重，草绿宫罗淡。", "喜银屏、小语私分。", "麝月春心一点。"],
    ["华年共有好愿，何时定妆鬟，莫雨零乱。", "梦似花飞，人归月冷。"],
    ["一夜晓山新怨。", "刘郎兴，寻常不浅，况不似，桃花春溪远。"],
    ["觉情随、晓马东风，病酒余香相半。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "蔡松年",
  "tune": "尉迟杯"
}
