{
  "title": "双燕",
  "paras": [
    ["柳阴庭院占风光。", "呢喃清昼长。", "碧波新涨小池塘。", "双双蹴水忙。"],
    ["萍散漫，絮飘扬。", "轻盈体态狂。", "为怜流去落红香。", "衔将归画梁。"],
    ["柳梢青〔侍宴禁中和张知合应制作〕"],
    ["桃靥红匀。", "梨腮粉薄，鸳径无尘。", "凤阁凌虚，龙池澄碧，芳意鳞鳞。"],
    ["清时酒圣花神。", "看内苑、风光更新。", "一部仙韶，九重鸾仗，天上长春。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "曾觌",
  "tune": "阮郎归"
}
