{
  "title": "梅",
  "paras": [
    ["踏白江梅，大都玉断酥凝就。", "雨肥霜逗。", "痴了闺房秀。"],
    ["莫待冬深，雪压风欺后。", "君知否。", "却嫌伊瘦。", "仍怕伊僝僽。"],
    ["点绛唇〔七夜，赵富文出家姬小琼，再赋丁亥七月己丑〕"],
    ["秋夜乘槎，客星容到天孙渚。", "眼波微注。", "将谓牵牛渡。"],
    ["见了还非，重理霓裳舞。", "都无误。", "几年一遇。", "莫讶周郎顾。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "周必大",
  "tune": "点绛唇"
}
