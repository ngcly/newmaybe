{
  "title": "送陈石泉南还",
  "paras": [
    ["归人犹未老。", "喜依旧，着南冠。", "正雪暗滹沱，云迷芒砀，梦落邯郸。"],
    ["乡心日行万里。", "幸此身生 燕山从不见吴山。", "回首一归难。"],
    ["慨故都禾黍。", "故家乔木。", "那忍重看。", "钧天紫城何处。"],
    ["问瑶池八骏几时还。", "谁在天津桥上。", "杜鹃声里栏杆。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "仇远",
  "tune": "木兰花慢"
}
