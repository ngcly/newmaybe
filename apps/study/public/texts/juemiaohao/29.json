{
  "title": "",
  "paras": [
    ["厌厌睡起，无限春情绪。", "柳色借轻烟，尚瘦怯、东风倦舞。"],
    ["海棠红皱，不奈晚来寒。", "帘半卷，日西沉，寂寞闲庭户。"],
    ["飞云无据，化作冥蒙雨。", "愁里见春来，又只恐、愁催春去。"],
    ["惜花人老，芳草梦凄迷。", "题欲遍，琐窗纱，总是伤春句。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "刘过",
  "tune": "蓦山溪"
}
