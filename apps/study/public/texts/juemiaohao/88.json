{
  "title": "蛾眉亭",
  "paras": [
    ["倚空绝壁，直下江千尺。", "天际两蛾凝黛，愁与恨，几时极。"],
    ["暮潮风正急，酒醒闻塞笛。", "试问谪仙何处？", "青山外，远烟碧。"],
    ["婺州（今浙江金华）。", "以荫入仕，光宗时弃官隐居西湖。", "与赵师秀、刘克庄等交游甚"],
    ["密。", "理宗淳佑三年卒，年六十五。", "有《花翁集》，已佚。", "事见《后村先生大全集》卷"],
    ["五○《孙花翁墓志铭》。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "姜夔",
  "tune": "霜天晓角"
}
