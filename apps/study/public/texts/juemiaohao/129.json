{
  "title": "",
  "paras": [
    ["柳烟浓，花露重，合是醉时候。", "楼倚花梢，长记小垂手。"],
    ["谁教钗燕轻分，镜鸾慵舞，是孤负、几番晴昼。"],
    ["自别后，闻道花底花前，多是两眉皱。", "又说新来，比似旧时瘦。"],
    ["须知两意常存，相逢终有。", "莫谩被、春光僝僽。"]
  ],
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  },
  "author": "王嵎",
  "tune": "祝英台近"
}
