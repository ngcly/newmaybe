{
  "title": "",
  "paras": [
    [
      "数声鶗鴃，又报芳菲歇。",
      "惜春更选残红折，雨轻风色暴，梅子青时节。",
      "永丰柳，无人尽日飞花雪。"
    ],
    [
      "莫把么弦拨，怨极弦能说。",
      "天不老，情难绝，心似双丝网，中有千千结。",
      "夜过也，东窗未白凝残月。"
    ]
  ],
  "author": "张先",
  "tune": "千秋岁",
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  }
}
