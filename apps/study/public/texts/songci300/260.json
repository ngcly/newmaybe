{
  "title": "蝉",
  "paras": [
    ["一襟馀恨宫魂断，年年翠阴庭树。", "乍咽凉柯，还移暗叶，重把离愁深诉。"],
    ["西窗过雨，怪瑶佩流空，玉筝调柱。"],
    ["镜暗妆残，为谁娇鬓尚如许？", "铜仙铅泪，似斜阳几度？", "馀音更苦，甚独抱"],
    ["清商，顿成凄楚。", "漫想熏风，柳丝千万缕。"]
  ],
  "author": "王沂孙",
  "tune": "齐天乐",
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  }
}
