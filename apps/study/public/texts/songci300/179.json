{
  "title": "晚春",
  "paras": [
    [
      "宝钗分，桃叶渡，烟柳暗南浦。",
      "怕上层楼，十日九风雨。",
      "断肠片片飞红，都无人管，更谁劝啼莺声住？"
    ],
    [
      "鬓边觑，应把花卜归期，才簪又重数。",
      "罗帐灯昏，哽咽梦中语。",
      "是他春带愁来，春归何处？",
      "却不解带将愁去。"
    ]
  ],
  "author": "辛弃疾",
  "tune": "祝英台近",
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  }
}
