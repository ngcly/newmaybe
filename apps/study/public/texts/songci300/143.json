{
  "title": "",
  "paras": [
    [
      "芳草碧色，萋萋遍南陌。",
      "暖絮乱红，也似知人，春愁无力。",
      "忆得盈盈拾翠侣，共携赏、凤城寒食。",
      "到今来，海角逢春，天涯为客。"
    ],
    [
      "愁旋释、还似织；",
      "泪暗拭，又偷滴。",
      "漫倚遍危阑，尽黄昏也，只是暮云凝碧。",
      "拚则而今已拚了，忘则怎生便忘得。",
      "又还问鳞鸿，试重寻消息。"
    ]
  ],
  "author": "李甲",
  "tune": "帝台春",
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  }
}
