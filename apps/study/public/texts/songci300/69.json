{
  "title": "",
  "paras": [
    ["倚危亭，恨如芳草，萋萋剗尽还生。", "念柳外青骢别后，水边红袂分时，怆"],
    ["然暗惊。", "无端天与娉婷。", "夜月一帘幽梦，春风十里柔情。"],
    ["怎奈何欢娱渐随流水，素弦声断，翠绡香减；", "那堪片片，飞花弄晚。", "蒙蒙"],
    ["残雨笼晴。", "正销凝，黄鹂又啼数声。"]
  ],
  "author": "秦观",
  "tune": "八六子",
  "layout": {
    "type": "ci",
    "watermark": "cloud",
    "writingMode": "vertical"
  }
}
