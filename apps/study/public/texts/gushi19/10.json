{
  "title": "迢迢牵牛星",
  "paras": [
    ["迢迢牵牛星，"],
    ["皎皎河汉女。"],
    ["纤纤擢素手，"],
    ["札札弄机杼。"],
    ["终日不成章，"],
    ["泣涕零如雨。"],
    ["河汉清且浅，"],
    ["相去复几许？"],
    ["盈盈一水间，"],
    ["脉脉不得语。"],
    ["【相近而不能达情，"],
    ["弥复可伤，"],
    ["此亦托兴之词。"],
    ["】"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
