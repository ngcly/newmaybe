{
  "title": "明月皎夜光",
  "paras": [
    ["明月皎夜光，"],
    ["促织鸣东壁。"],
    ["玉衡指孟冬，"],
    ["众星何历历。"],
    ["白露沾野草，"],
    ["时节忽复易。"],
    ["秋蝉鸣树间，"],
    ["玄鸟逝安适。"],
    ["昔我同门友，"],
    ["高举振六翮。"],
    ["不念携手好，"],
    ["弃我如遗迹。"],
    ["南箕北有斗，"],
    ["牵牛不负轭。"],
    ["良无磐石固，"],
    ["虚名复何益。"],
    ["【“南箕”二语，"],
    ["言有名而无实也，"],
    ["此兴意与“玉衡指孟冬”正用者自别。"],
    ["】"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
