{
  "title": "客从远方来",
  "paras": [
    ["客从远方来，"],
    ["遗我一端绮。"],
    ["相去万余里，"],
    ["故人心尚尔。"],
    ["文彩双鸳鸯，"],
    ["裁为合欢被。"],
    ["著【掌吕反。"],
    ["】以长相思，"],
    ["缘【以绢切。"],
    ["】以结不解。"],
    ["以胶投漆中，"],
    ["谁能别离此？"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
