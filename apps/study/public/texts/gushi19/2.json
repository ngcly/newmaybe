{
  "title": "青青河畔草",
  "paras": [
    ["青青河畔草，"],
    ["郁郁园中柳。"],
    ["盈盈楼上女，"],
    ["皎皎当窗牖。"],
    ["娥娥红粉妆，"],
    ["纤纤出素手。"],
    ["昔为倡家女，"],
    ["今为荡子妇。"],
    ["荡子行不归，"],
    ["空床难独守。"],
    ["【用叠字，"],
    ["从卫《硕人》“河水洋洋，"],
    ["北流活活”一章化出。"],
    ["】"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
