{
  "title": "今日良宴会",
  "paras": [
    ["今日良宴会，"],
    ["欢乐难具陈。"],
    ["弹筝奋逸响，"],
    ["新声妙入神。"],
    ["令德唱高言，"],
    ["识曲听其真。"],
    ["齐心同所愿，"],
    ["含意俱未申。"],
    ["人生寄一世，"],
    ["奄忽若飙尘。"],
    ["何不策高足，"],
    ["先据要路津。"],
    ["无为守穷贱，"],
    ["轗轲长苦辛。"],
    ["【据要津乃诡词也，"],
    ["古人感愤，"],
    ["每有此种。"],
    ["】"]
  ],
  "layout": {
    "type": "prose",
    "watermark": "none",
    "writingMode": "horizontal"
  }
}
