{
  "name": "newmaybe",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node --import tsx ../../scripts/build-shared-fonts.ts",
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "node --import tsx ../../scripts/build-shared-fonts.ts",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ma-shan-zheng": "~5.3.1",
    "@newmaybe/content": "*",
    "@newmaybe/design-tokens": "*",
    "@newmaybe/shared-styles": "*",
    "astro": "^7.0.7",
    "satori": "^0.26.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "~5.2.11",
    "@fontsource/noto-serif-sc": "~5.2.9",
    "pagefind": "^1.5.2"
  }
}
