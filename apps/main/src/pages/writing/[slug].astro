---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sortPostsForDisplay } from '../../lib/posts';
import { resolveConnections } from '../../lib/connections';
import TableOfContents from '../../components/TableOfContents.astro';
import FontScaler from '../../components/FontScaler.astro';
import ResumeToast from '../../components/ResumeToast.astro';
import PostNav from '../../components/PostNav.astro';
import RelatedConnections from '../../components/RelatedConnections.astro';
import '../../styles/article.css';

// 为每篇文章生成一个静态页面
export async function getStaticPaths() {
  const posts = sortPostsForDisplay(await getCollection('posts', ({ data }) => !data.draft));
  return posts.map((post, index) => {
    // 列表是降序排列（最新/权重最高的排在最前）
    // 上一篇（列表上一项，即较新的文章）是前一项 index - 1
    // 下一篇（列表下一项，即较旧的文章）是后一项 index + 1
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;

    return {
      params: { slug: post.id },
      props: {
        post,
        prev: prevPost ? { id: prevPost.id, title: prevPost.data.title } : null,
        next: nextPost ? { id: nextPost.id, title: nextPost.data.title } : null,
      },
    };
  });
}

type Props = {
  post: CollectionEntry<'posts'>;
  prev: { id: string; title: string } | null;
  next: { id: string; title: string } | null;
};

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

const longDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isPoetry = post.data.category === '诗歌';
const watermark = post.data.watermark;

const connections = await resolveConnections(post.data.connections);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = !isPoetry && toc.length >= 2;
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={`/og/${post.id}.png`}
  article={true}
  publishDate={post.data.pubDate}
>
  <div id="reading-bar" aria-hidden="true"></div>
  <ResumeToast postId={post.id} />
  <article class="article">
    <div class="wrap">
      {
        isPoetry ? (
          <>
            <header class="article-head reveal">
              <a href="/writing" class="back">
                ← 返回文字
              </a>
              <span class="cat">{post.data.category}</span>
              <button
                type="button"
                class="layout-toggle-minimal"
                id="layoutToggle"
                title="切换版式"
                aria-label="切换诗歌版式"
              >
                <span class="label">版式：</span>
                <span class="opt opt-vert">竖</span>
                <span class="divider">/</span>
                <span class="opt opt-horiz">横</span>
              </button>
              <h1 transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
              <div class="meta">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  transition:name={`post-date-${post.id}`}
                >
                  {longDate}
                </time>
                {post.data.readingTime && <span> · 约 {post.data.readingTime} 分钟</span>}
                <FontScaler />
              </div>
            </header>

            <div class="poem-wrap">
              {watermark && (
                <span class="watermark" aria-hidden="true">
                  {watermark}
                </span>
              )}
              <div class="prose">
                <Content />
              </div>
              <div class="scroll-hint-poetry" id="poetryScrollHint" aria-hidden="true">
                <span class="hint-arrow">←</span> 左右滑动阅读
              </div>
            </div>
          </>
        ) : (
          <div class="editorial-container">
            <header class="article-head reveal">
              <a href="/writing" class="back">
                ← 返回文字
              </a>
              <span class="cat">{post.data.category}</span>
              <h1 transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
              <div class="meta">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  transition:name={`post-date-${post.id}`}
                >
                  {longDate}
                </time>
                {post.data.readingTime && <span> · 约 {post.data.readingTime} 分钟</span>}
                <FontScaler />
              </div>

              {hasToc && <TableOfContents toc={toc} variant="desktop" />}
            </header>

            <div class="editorial-content">
              {hasToc && <TableOfContents toc={toc} variant="mobile" />}

              <div class="prose editorial">
                <Content />
              </div>
            </div>
          </div>
        )
      }

      <PostNav prev={prev ?? undefined} next={next ?? undefined} />
      <RelatedConnections connections={connections} />
    </div>
  </article>

  {
    isPoetry && (
      <script is:inline>
        (function () {
          const setupImmersiveScroll = () => {
            let lastScrollY = window.scrollY;
            const hdr = document.getElementById('hdr');
            if (!hdr) return;

            const onScrollPoetry = () => {
              const currentScrollY = window.scrollY;
              if (currentScrollY > 100 && currentScrollY > lastScrollY) {
                hdr.style.transform = 'translateY(-100%)';
                hdr.style.opacity = '0';
                hdr.style.transition = 'transform 0.4s ease, opacity 0.4s ease';
              } else {
                hdr.style.transform = 'translateY(0)';
                hdr.style.opacity = '1';
              }
              lastScrollY = currentScrollY;
            };

            if (window._onScrollPoetry) {
              window.removeEventListener('scroll', window._onScrollPoetry);
            }
            window.addEventListener('scroll', onScrollPoetry, { passive: true });
            window._onScrollPoetry = onScrollPoetry;
          };

          setupImmersiveScroll();

          // 竖排/横排切换 —— 用 localStorage 记住用户偏好，View Transitions 后也不丢失
          const LAYOUT_KEY = 'poetry-layout';
          const applyPoetryLayout = () => {
            const poemWrap = document.querySelector('.poem-wrap');
            const toggle = document.getElementById('layoutToggle');
            if (!poemWrap || !toggle) return;
            const isVertical = localStorage.getItem(LAYOUT_KEY) === 'vertical';
            poemWrap.classList.toggle('vertical', isVertical);
            toggle.classList.toggle('is-vertical', isVertical);

            const prose = poemWrap.querySelector('.prose');

            // Bind scroll event to hide hint and apply watermark parallax
            const hint = document.getElementById('poetryScrollHint');
            const watermark = poemWrap.querySelector('.watermark');

            // 清理上一次的事件监听，防止 View Transitions 页面载入时泄漏与重复绑定
            // @ts-ignore
            if (poemWrap._onProseScroll) {
              // @ts-ignore
              poemWrap.removeEventListener('scroll', poemWrap._onProseScroll);
              // @ts-ignore
              poemWrap._onProseScroll = null;
            }
            // @ts-ignore
            if (poemWrap._onProseWheel) {
              // @ts-ignore
              poemWrap.removeEventListener('wheel', poemWrap._onProseWheel);
              // @ts-ignore
              poemWrap._onProseWheel = null;
            }
            // @ts-ignore
            if (poemWrap._onScrollPoetryHint) {
              // @ts-ignore
              poemWrap.removeEventListener('scrollend', poemWrap._onScrollPoetryHint);
              // @ts-ignore
              poemWrap._onScrollPoetryHint = null;
            }

            if (isVertical && prose) {
              const onProseScroll = () => {
                if (watermark) {
                  // 水印视差滚动平移（监听外层滚动容器 poemWrap 的 scrollLeft）
                  watermark.style.transform = `translate(calc(-50% - ${poemWrap.scrollLeft * 0.25}px), -50%)`;
                }
              };
              poemWrap.addEventListener('scroll', onProseScroll, { passive: true });
              // @ts-ignore
              poemWrap._onProseScroll = onProseScroll;
              onProseScroll(); // 初始化对齐

              // 解决桌面端鼠标滚轮无法横向滚动的问题
              const onProseWheel = (e) => {
                if (e.deltaY !== 0) {
                  poemWrap.scrollLeft -= e.deltaY;
                  e.preventDefault();
                }
              };
              poemWrap.addEventListener('wheel', onProseWheel, { passive: false });
              // @ts-ignore
              poemWrap._onProseWheel = onProseWheel;

              if (hint) {
                hint.style.opacity = '';
                hint.style.pointerEvents = '';
                const handleScrollEnd = () => {
                  hint.style.opacity = '0';
                  hint.style.pointerEvents = 'none';
                  poemWrap.removeEventListener('scrollend', handleScrollEnd);
                };
                poemWrap.addEventListener('scrollend', handleScrollEnd);
                // @ts-ignore
                poemWrap._onScrollPoetryHint = handleScrollEnd;
              }
            } else {
              if (watermark) watermark.style.transform = '';
              if (hint) {
                hint.style.opacity = '0';
                hint.style.pointerEvents = 'none';
              }
            }
          };
          applyPoetryLayout();

          if (window._handleLayoutClick) {
            document.removeEventListener('click', window._handleLayoutClick);
          }
          const handleLayoutClick = (e) => {
            const btn = e.target.closest('#layoutToggle');
            if (!btn) return;
            const poemWrap = document.querySelector('.poem-wrap');
            if (!poemWrap) return;
            const nowVertical = poemWrap.classList.toggle('vertical');
            btn.classList.toggle('is-vertical', nowVertical);
            localStorage.setItem(LAYOUT_KEY, nowVertical ? 'vertical' : 'horizontal');
            applyPoetryLayout();
          };
          document.addEventListener('click', handleLayoutClick);
          window._handleLayoutClick = handleLayoutClick;
        })();
      </script>
    )
  }
</Base>

<script src="../../scripts/reading-enhancements.ts"></script>
