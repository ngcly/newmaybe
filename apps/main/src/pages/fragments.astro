---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { render } from 'astro:content';

const fragments = (await getCollection('fragments', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="念头" description="一些来不及展开的句子，半成形的念头，以及那些闪过便消失的瞬间。">
  <section class="fragments-page">
    <div class="wrap">
      <header class="frag-head reveal">
        <h1>念头<span class="zh">碎片集</span></h1>
        <p class="intro">来不及展开的句子，半成形的念头，以及那些闪过便消失的瞬间。</p>
      </header>

      <div class="timeline">
        {
          fragments.map(async (frag, i) => {
            const { Content } = await render(frag);
            return (
              <article
                id={frag.id}
                class="frag-card reveal"
                style={`animation-delay: ${i * 0.06}s`}
              >
                <div class="frag-aside">
                  <time class="frag-date">{fmtDate(frag.data.pubDate)}</time>
                  {(frag.data.mood || frag.data.location) && (
                    <div class="frag-meta">
                      {frag.data.location && (
                        <span class="meta-loc">
                          <Icon name="pin" /> {frag.data.location}
                        </span>
                      )}
                      {frag.data.mood && <span class="meta-mood">{frag.data.mood}</span>}
                    </div>
                  )}
                </div>
                <div class="frag-body">
                  <Content />
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .fragments-page {
    padding: 5rem 0 7rem;
  }

  .frag-head {
    max-width: 60ch;
    margin: 0 auto 5rem;
    text-align: center;
  }
  .frag-head h1 {
    font-weight: 500;
    font-size: var(--fs-title);
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 1.8rem;
  }
  .frag-head .intro {
    font-size: var(--fs-base);
    line-height: 1.9;
    color: var(--ink-soft);
    font-weight: 300;
  }

  /* 时间轴容器 */
  .timeline {
    --tl-col: 140px;
    --tl-gap: 2.5rem;
    max-width: 740px;
    margin: 0 auto;
    position: relative;
  }
  /* 左侧纵线：对齐到左栏右边缘 + 半格偏移 */
  .timeline::before {
    content: '';
    position: absolute;
    left: calc(var(--tl-col) + 8px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  /* 碎片卡片 */
  .frag-card {
    display: grid;
    grid-template-columns: var(--tl-col) 1fr;
    gap: 0 var(--tl-gap);
    padding: 2rem 0 2rem;
    position: relative;
  }

  /* 从链接跳来时，正文底色短暂泛起再褪去 */
  .frag-card:target .frag-body {
    margin: -0.6rem -0.8rem;
    padding: 0.75rem 0.8rem 0.6rem;
    border-radius: var(--corner-md);
    animation: targetFragHighlight 2.5s ease-out forwards;
  }

  @keyframes targetFragHighlight {
    0% {
      background-color: color-mix(in srgb, var(--ochre) 12%, transparent);
    }
    100% {
      background-color: transparent;
    }
  }
  /* 时间轴节点圆点 */
  .frag-card::before {
    content: '';
    position: absolute;
    left: calc(var(--tl-col) + 4px);
    top: 2.6rem;
    width: 9px;
    height: 9px;
    border-radius: var(--corner-sm);
    transform: rotate(45deg);
    background: var(--paper);
    border: 1.5px solid var(--ochre);
    transition:
      background 0.3s ease,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
  }
  .frag-card:hover::before {
    background: var(--ochre);
    transform: rotate(45deg) scale(1.25);
  }

  /* 左栏：日期 + 元信息 */
  .frag-aside {
    text-align: right;
    padding-top: 0.2rem;
  }
  .frag-date {
    display: block;
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    line-height: 1.6;
    letter-spacing: 0.04em;
  }
  .frag-meta {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
  }
  .meta-loc,
  .meta-mood {
    font-family: var(--serif-cn);
    font-size: var(--fs-xs);
    color: var(--ink-faint);
  }

  /* 右栏：正文直接落在纸面上，由时间轴与留白分隔 */
  .frag-body {
    padding-top: 0.15rem;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .frag-card:hover .frag-body {
    transform: translateX(4px);
  }
  .frag-body :global(p) {
    font-size: var(--fs-base);
    line-height: 1.95;
    color: var(--ink-soft);
    font-weight: 300;
    margin: 0;
  }
  .frag-body :global(p + p) {
    margin-top: 1rem;
  }

  @media (max-width: 680px) {
    .timeline::before {
      display: none;
    }
    .frag-card {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      padding: 1.6rem 0;
      border-top: 1px solid var(--line);
    }
    .frag-card::before {
      display: none;
    }
    .frag-aside {
      order: -1;
      text-align: left;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .frag-meta {
      margin-top: 0;
      flex-direction: row;
      gap: 0.6rem;
    }
    .frag-card:hover .frag-body {
      transform: none;
    }
  }
</style>
