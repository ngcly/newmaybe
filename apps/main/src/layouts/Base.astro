---
import { SITE } from '../config';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
  description?: string;
  /** OG 图路径，相对站点根，如 /og/post-slug.png */
  image?: string;
  /** 是否为文章页，影响 og:type */
  article?: boolean;
  /** 发布时间，用于 JSON-LD 结构化数据 */
  publishDate?: Date;
  /** 可选的页尾题记跋文（金句） */
  epigraph?: string;
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  article = false,
  publishDate,
  epigraph,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      const applyTheme = () => {
        // Cookie is the canonical theme store (server-readable, shared across subdomains).
        // localStorage is kept as a migration fallback for existing users.
        const getCookie = (name) => {
          const row = document.cookie.split(';').find((c) => c.trim().startsWith(name + '='));
          return row ? row.trim().slice(name.length + 1) : null;
        };
        const theme =
          getCookie('theme') ||
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
        // Write to Cookie (authoritative) so the server can read it pre-render.
        const domainAttr = window.location.hostname.includes('newmaybe.com')
          ? '; domain=.newmaybe.com'
          : '';
        document.cookie = `theme=${theme}; path=/${domainAttr}; max-age=31536000; SameSite=Lax`;
      };

      applyTheme();

      // 在 View Transitions 交换 DOM 前同步主题类名，防止由于系统暗色偏好引发的瞬间闪烁
      document.addEventListener('astro:before-swap', (ev) => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          ev.newDocument.documentElement.classList.add('dark');
          ev.newDocument.documentElement.classList.remove('light');
        } else {
          ev.newDocument.documentElement.classList.add('light');
          ev.newDocument.documentElement.classList.remove('dark');
        }
      });

      document.addEventListener('astro:after-swap', applyTheme);

      // 在 DOM 交换完成后立即应用诗歌版式偏好，防止横竖排闪烁
      document.addEventListener('astro:after-swap', () => {
        const poemWrap = document.querySelector('.poem-wrap');
        if (!poemWrap) return;
        const isVertical = localStorage.getItem('poetry-layout') === 'vertical';
        poemWrap.classList.toggle('is-horizontal', !isVertical);
        const toggle = document.getElementById('layoutToggle');
        if (toggle) toggle.classList.toggle('is-vertical', isVertical);
      });
    </script>
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {
      article && publishDate && (
        <meta property="article:published_time" content={publishDate.toISOString()} />
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon & Touch Icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        article
          ? {
              '@context': 'https://schema.org',
              '@type': 'BlogPosting',
              headline: title ?? SITE.title,
              description: description,
              image: ogImage,
              url: canonical,
              datePublished: publishDate ? publishDate.toISOString() : undefined,
              author: {
                '@type': 'Person',
                name: SITE.author,
                url: SITE.url,
              },
              publisher: {
                '@type': 'Organization',
                name: SITE.title,
                url: SITE.url,
              },
            }
          : {
              '@context': 'https://schema.org',
              '@type': 'WebSite',
              name: SITE.title,
              url: SITE.url,
              description: SITE.description,
              author: {
                '@type': 'Person',
                name: SITE.author,
              },
            },
      )}
    />
  </head>

  <body>
    <Header currentPath={currentPath} />
    <MobileDrawer currentPath={currentPath} />

    <main data-pagefind-body>
      <slot />
    </main>

    <Footer epigraph={epigraph} year={year} />

    <Search />

    <script src="../scripts/layout-interactions.ts"></script>
  </body>
</html>

<style>
  main {
    padding-top: 72px;
  }
</style>
