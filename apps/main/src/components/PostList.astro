---
import type { CollectionEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  index?: string;
  heading?: string;
  subheading?: string;
  showMore?: boolean;
  showHeading?: boolean;
}

const {
  posts,
  index = '壹',
  heading = '近期文字',
  subheading = '新写与旧作',
  showMore = true,
  showHeading = true,
} = Astro.props;

const fmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
---

<section class="section" id="writing">
  <div class="wrap">
    {
      showHeading && (
        <SectionHead
          index={index}
          title={heading}
          subtitle={subheading}
          more={showMore ? { href: '/writing', label: '全部文字' } : undefined}
        />
      )
    }

    {
      posts.map((post) => (
        <article class="post reveal" data-category={post.data.category}>
          <a href={`/writing/${post.id}`}>
            <span class="date" transition:name={`post-date-${post.id}`}>
              {fmt(post.data.pubDate)}
            </span>
            <div class="post-body">
              <h3 transition:name={`post-title-${post.id}`}>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="tag">
                {post.data.category}
                {post.data.readingTime && ` · ${post.data.readingTime} 分钟`}
              </span>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .section {
    padding: 4.5rem 0;
  }
  .post {
    padding: 2.2rem 0;
    border-top: 1px solid var(--line);
    position: relative;
    transition:
      padding-left 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.45s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      max-height 0.45s ease,
      padding-top 0.45s ease,
      padding-bottom 0.45s ease,
      border-color 0.35s ease;
    overflow: hidden;
    max-height: 250px;
  }
  .post.hidden {
    opacity: 0;
    transform: translateY(15px);
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-color: transparent;
    pointer-events: none;
  }
  .post > a {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 2.5rem;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
  }
  .post:last-child {
    border-bottom: 1px solid var(--line);
    transition: border-bottom-color 0.45s ease;
  }
  .post.hidden:last-child {
    border-bottom-color: transparent;
  }
  .post:hover {
    padding-left: 1.2rem;
    border-top-color: color-mix(in srgb, var(--ochre) 40%, var(--line));
  }
  .post .date {
    color: var(--ink-faint);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    transition: color 0.3s ease;
  }
  .post:hover .date {
    color: var(--ochre);
  }
  .post h3 {
    font-weight: 500;
    font-size: var(--fs-xl);
    line-height: 1.4;
    margin-bottom: 0.6rem;
    transition: color 0.3s ease;
    color: var(--ink);
  }
  .post:hover h3 {
    color: var(--ochre);
  }
  .post p {
    color: var(--ink-soft);
    font-size: var(--fs-base);
    font-weight: 300;
    max-width: 60ch;
  }
  .post .tag {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  @media (max-width: 680px) {
    .post > a {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .post .date {
      font-size: var(--fs-sm);
    }
    /* 单列堆叠下卡片内容可能超过 250px，解除高度限制避免静默裁切；
       过滤动画在该断点降级为纯透明度（.post.hidden 的 max-height: 0 仍生效） */
    .post {
      max-height: none;
    }
  }
</style>
