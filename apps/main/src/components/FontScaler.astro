---
// 文章字号微调组件 (A- / A+)
---

<span class="font-scaler" aria-label="字号调节">
  <span class="scaler-sep">·</span>
  <button type="button" class="scaler-btn font-scale-down" title="减小字号" aria-label="减小字号">
    A-
  </button>
  <span class="scaler-divider">/</span>
  <button type="button" class="scaler-btn font-scale-up" title="增大字号" aria-label="增大字号">
    A+
  </button>
</span>
