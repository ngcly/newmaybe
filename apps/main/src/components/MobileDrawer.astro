---
import { SITE, NAV, resolveSubdomain } from '../config';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  const pathPart = currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath;
  const hrefPart = href.endsWith('/') ? href.slice(0, -1) : href;
  return pathPart === hrefPart || pathPart.startsWith(hrefPart + '/');
};
---

<div class="mobile-menu" id="mobileMenu" aria-hidden="true" data-pagefind-ignore="all">
  <div class="mobile-overlay" id="mobileOverlay"></div>
  <div class="mobile-drawer">
    <div class="drawer-head">
      <a href="/" class="drawer-logo">{SITE.title}<span class="dot">.</span></a>
    </div>
    <nav class="drawer-links">
      {
        NAV.map((item, i) => (
          <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
            <span class="drawer-idx">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="drawer-eco">
      <div class="drawer-eco-title">数字生态 · 独立子空间</div>
      <div class="drawer-eco-grid">
        <a
          href={resolveSubdomain('https://graph.newmaybe.com')}
          target="_blank"
          rel="noopener noreferrer"
        >
          思维图谱 ↗
        </a>
        <a
          href={resolveSubdomain('https://ai.newmaybe.com')}
          target="_blank"
          rel="noopener noreferrer"
        >
          AI 园丁 ↗
        </a>
        <a
          href={resolveSubdomain('https://study.newmaybe.com')}
          target="_blank"
          rel="noopener noreferrer"
        >
          林下书房 ↗
        </a>
        <a
          href={resolveSubdomain('https://studio.newmaybe.com')}
          target="_blank"
          rel="noopener noreferrer"
        >
          创作工坊 ↗
        </a>
        <a
          href={resolveSubdomain('https://club.newmaybe.com')}
          target="_blank"
          rel="noopener noreferrer"
        >
          文友雅集 ↗
        </a>
        <a
          href={resolveSubdomain('https://lab.newmaybe.com')}
          target="_blank"
          rel="noopener noreferrer"
        >
          实验室 ↗
        </a>
      </div>
    </div>

    <div class="drawer-foot">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
</div>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s 0.4s;
  }
  .mobile-menu.open {
    pointer-events: auto;
    visibility: visible;
    transition: visibility 0s;
  }
  .mobile-overlay {
    position: absolute;
    inset: 0;
    background: rgba(30, 25, 18, 0.35);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .mobile-menu.open .mobile-overlay {
    opacity: 1;
  }
  .mobile-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(78%, 320px);
    background: var(--paper);
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mobile-menu.open .mobile-drawer {
    transform: translateX(0);
  }
  .drawer-head {
    height: 72px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding: 0 2rem;
    border-bottom: 1px solid var(--line);
  }
  .drawer-logo {
    font-family: var(--serif-en);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .drawer-logo .dot {
    color: var(--ochre);
  }
  .drawer-links {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem 2rem;
  }
  .drawer-links a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--serif-cn);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--ink-soft);
    text-decoration: none;
    letter-spacing: 0.06em;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    transition:
      color 0.2s,
      padding-left 0.3s ease;
  }
  .drawer-links a:first-child {
    border-top: 1px solid var(--line);
  }
  .drawer-links a:hover,
  .drawer-links a.active {
    color: var(--ochre);
    padding-left: 0.4rem;
  }
  .drawer-idx {
    font-family: var(--serif-en);
    font-style: italic;
    font-size: 0.8rem;
    color: var(--ink-faint);
    flex-shrink: 0;
  }
  /* 抽屉内生态矩阵 */
  .drawer-eco {
    padding: 1.2rem 2rem;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper-deep) 60%, transparent);
  }
  .drawer-eco-title {
    font-family: var(--serif-cn);
    font-size: 0.8rem;
    color: var(--ink-faint);
    letter-spacing: 0.08em;
    margin-bottom: 0.8rem;
  }
  .drawer-eco-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  .drawer-eco-grid a {
    font-family: var(--serif-cn);
    font-size: 0.84rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    background: var(--paper);
    border: 1px solid var(--line);
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .drawer-eco-grid a:hover {
    color: var(--ochre);
    border-color: var(--ochre);
  }

  .drawer-foot {
    flex-shrink: 0;
    padding: 1.5rem 2rem;
    border-top: 1px solid var(--line);
  }
  .drawer-foot a {
    font-family: var(--serif-en);
    font-style: italic;
    font-size: 0.82rem;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.2s;
  }
  .drawer-foot a:hover {
    color: var(--ochre);
  }
</style>
