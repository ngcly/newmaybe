---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import SealStamp from './SealStamp.astro';

interface Props {
  fragment?: CollectionEntry<'fragments'>;
  excerpt?: CollectionEntry<'excerpts'>;
}

const { fragment, excerpt } = Astro.props;

const FragmentContent = fragment ? (await render(fragment)).Content : null;
const ExcerptContent = excerpt ? (await render(excerpt)).Content : null;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section class="section-echoes" id="echoes">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Echoes & Fragments</span>
        <h2>
          念头与拾遗<span class="cn">瞬息与摘录</span>
        </h2>
      </div>
      <p class="section-intro">一侧是即时生发的瞬息手记，一侧是偶遇驻留的他山字句。</p>
    </div>

    <div class={`echoes-grid ${!(fragment && excerpt) ? 'is-single' : ''}`}>
      {
        fragment && FragmentContent && (
          <article class="echo-card frag-card reveal">
            <div class="card-top">
              <span class="badge-text">Fragment · 最新念头</span>
            </div>

            <div class="card-body frag-body">
              <FragmentContent />
            </div>

            <div class="card-foot">
              <div class="frag-meta">
                <time class="card-date" datetime={fragment.data.pubDate.toISOString()}>
                  {fmtDate(fragment.data.pubDate)}
                </time>
                {fragment.data.location && (
                  <span class="meta-item">
                    <span aria-hidden="true">📍</span> {fragment.data.location}
                  </span>
                )}
                {fragment.data.mood && <span class="meta-item">{fragment.data.mood}</span>}
              </div>
              <a href="/fragments" class="card-link">
                全部念头 <span class="arrow">→</span>
              </a>
            </div>
          </article>
        )
      }

      {
        excerpt && ExcerptContent && (
          <figure class="echo-card excerpt-card reveal">
            <div class="card-top">
              <span class="badge-text">Excerpt · 今日拾遗</span>
            </div>

            <div class="card-body excerpt-body">
              <span class="quote-mark" aria-hidden="true">
                “
              </span>
              <blockquote class="excerpt-text">
                <ExcerptContent />
              </blockquote>
              {excerpt.data.comment && <p class="excerpt-comment">{excerpt.data.comment}</p>}
            </div>

            <figcaption class="card-foot">
              <div class="excerpt-source">
                <span class="source-text">
                  <span class="dash">—</span>
                  <span class="author">{excerpt.data.author}</span>
                  {excerpt.data.source && <cite class="source">《{excerpt.data.source}》</cite>}
                </span>
                <SealStamp text="拾遗" type="yang" size="sm" title="拾遗印记" />
              </div>
              <a href="/excerpts" class="card-link">
                全部拾遗 <span class="arrow">→</span>
              </a>
            </figcaption>
          </figure>
        )
      }
    </div>
  </div>
</section>

<style>
  .section-echoes {
    padding: 4.5rem 0;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .section-head h2 {
    font-family: var(--serif-en);
    font-weight: 600;
    font-size: 2.2rem;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  .section-head h2 .cn {
    font-family: var(--serif-cn);
    font-size: 1.4rem;
    color: var(--ink-faint);
    font-weight: 400;
    margin-left: 0.8rem;
  }

  .section-intro {
    color: var(--ink-soft);
    font-size: 0.95rem;
    max-width: 32ch;
    line-height: 1.7;
    margin: 0;
  }

  /* 保留双栏对齐，让每则文字按内容自然收尾。 */
  .echoes-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .echoes-grid.is-single {
    grid-template-columns: minmax(0, 720px);
    justify-content: center;
  }

  /* 文字直接落在纸面上，留白承担分隔。 */
  .echo-card {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .card-top {
    margin-bottom: 1.4rem;
  }

  .badge-text {
    font-family: var(--serif-cn);
    font-size: 0.88rem;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
  }

  .frag-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.7rem;
    font-family: var(--serif-cn);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .meta-item::before {
    content: '·';
    margin-right: 0.7rem;
  }

  /* 卡片正文 */
  .card-body {
    margin-bottom: 1.5rem;
  }

  /* 念头正文样式 */
  .frag-body :global(p) {
    font-size: 1.14rem;
    line-height: 2;
    color: var(--ink-soft);
    font-weight: 300;
    margin: 0;
    letter-spacing: 0.03em;
    text-align: start;
  }

  .frag-body :global(p + p) {
    margin-top: 1rem;
  }

  /* 拾遗正文样式（古典楷体 + 典雅字距） */
  .excerpt-body {
    position: relative;
  }

  .quote-mark {
    position: absolute;
    top: -0.65rem;
    left: -1.15rem;
    font-family: var(--serif-en);
    font-size: 3.5rem;
    color: var(--ochre);
    opacity: 0.18;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .excerpt-text {
    font-family: var(--serif-kai), 'Kaiti SC', 'STKaiti', 'KaiTi', var(--serif-cn), serif;
    font-size: 1.25rem;
    line-height: 2.05;
    letter-spacing: 0.045em;
    color: var(--ink);
    margin: 0;
    padding: 0;
    border: none;
    font-style: normal;
    position: relative;
    z-index: 1;
  }

  .excerpt-text :global(p) {
    margin: 0;
    text-align: start;
    font-weight: 400;
  }

  .excerpt-text :global(p + p) {
    margin-top: 0.8rem;
  }

  .excerpt-comment {
    margin-top: 1.2rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
    line-height: 1.6;
    font-weight: 300;
    font-style: italic;
  }

  /* 日期与出处作为落款，归档链接退到下一行。 */
  .card-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .card-date {
    font-family: var(--serif-en);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--ink-faint);
  }

  .card-link {
    font-family: var(--serif-cn);
    font-size: 0.88rem;
    color: var(--ink-faint);
    text-decoration: none;
    letter-spacing: 0.06em;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s,
      color 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .card-link .arrow {
    transition: transform 0.25s ease;
  }

  .card-link:hover,
  .card-link:focus-visible {
    color: var(--ochre);
    border-bottom-color: var(--ochre);
  }

  .card-link:hover .arrow {
    transform: translateX(3px);
  }

  /* 拾遗底部 */
  .excerpt-source {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--serif-cn);
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .source-text {
    min-width: 0;
  }

  .dash {
    color: var(--ochre);
    margin-right: 0.4rem;
  }

  .author {
    font-weight: 500;
  }

  .source {
    font-style: normal;
    color: var(--ink-faint);
  }

  /* 响应式适配 */
  @media (max-width: 860px) {
    .echoes-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  @media (max-width: 680px) {
    .section-echoes {
      padding: 3.5rem 0;
    }

    .section-head {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 2rem;
      gap: 0.8rem;
    }

    .card-top {
      margin-bottom: 1rem;
    }

    .excerpt-text {
      font-size: 1.15rem;
      line-height: 1.95;
    }

    .frag-body :global(p) {
      font-size: 1.05rem;
      line-height: 1.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link,
    .card-link .arrow {
      transition: none;
    }

    .card-link:hover .arrow {
      transform: none;
    }
  }
</style>
