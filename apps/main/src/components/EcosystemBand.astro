---
import { resolveSubdomain } from '../config';

// 首页只留一行名字；完整介绍在页眉「生态」菜单里
const APPS = [
  { name: '思维图谱', desc: '思考的经纬与概念网络', url: 'https://graph.newmaybe.com' },
  { name: 'AI 园丁', desc: '数字花园漫游与语料问答', url: 'https://ai.newmaybe.com' },
  { name: '林下书房', desc: '四十三部古籍与写作研习', url: 'https://study.newmaybe.com' },
  { name: '创作工坊', desc: '排版工具、卡片海报与灵感引擎', url: 'https://studio.newmaybe.com' },
  { name: '文友雅集', desc: '慢节奏人文写作与专题文集社区', url: 'https://club.newmaybe.com' },
  { name: '实验室', desc: '图形感知与声色交互实验', url: 'https://lab.newmaybe.com' },
] as const;
---

<section class="eco-strip" id="ecosystem" aria-labelledby="ecosystem-title">
  <div class="wrap eco-inner reveal">
    <h2 id="ecosystem-title" class="eco-label">数字生态</h2>
    <ul class="eco-links" role="list">
      {
        APPS.map((app) => (
          <li>
            <a
              href={resolveSubdomain(app.url)}
              target="_blank"
              rel="noopener noreferrer"
              title={app.desc}
            >
              {app.name}
              <span class="arr" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .eco-strip {
    padding: 2.6rem 0;
    scroll-margin-top: 80px;
  }
  .eco-inner {
    display: flex;
    align-items: baseline;
    gap: 1rem 3rem;
  }
  .eco-label {
    flex-shrink: 0;
    font-size: var(--fs-sm);
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
  }
  .eco-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .eco-links a {
    font-size: var(--fs-base);
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .eco-links a:hover,
  .eco-links a:focus-visible {
    color: var(--ochre);
    border-bottom-color: var(--ochre);
  }
  .arr {
    margin-left: 0.25rem;
    font-size: var(--fs-xs);
    color: var(--ink-faint);
  }
  @media (max-width: 680px) {
    .eco-inner {
      flex-direction: column;
    }
    .eco-links {
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      gap: 0.9rem 1.8rem;
    }
  }
</style>
