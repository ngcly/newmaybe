---
import { SITE, NAV, resolveSubdomain } from '../config';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  const pathPart = currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath;
  const hrefPart = href.endsWith('/') ? href.slice(0, -1) : href;
  return pathPart === hrefPart || pathPart.startsWith(hrefPart + '/');
};
---

<header id="hdr" data-pagefind-ignore="all">
  <nav>
    <a href="/" class="logo">{SITE.title}<span class="dot">.</span></a>
    <ul class="nav-links">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="nav-eco-li">
        <button
          class="nav-eco-trigger"
          id="ecoNavTrigger"
          aria-label="探索数字生态"
          aria-expanded="false"
          type="button"
        >
          <span>生态</span>
          <svg
            class="eco-caret"
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <div class="eco-dropdown" id="ecoDropdown" aria-hidden="true" inert>
          <div class="eco-dropdown-header">
            <span class="eco-dropdown-title">数字生态 · 漫游子空间</span>
            <span class="eco-dropdown-sub">6 Spaces</span>
          </div>
          <div class="eco-dropdown-grid">
            <a
              href={resolveSubdomain('https://graph.newmaybe.com')}
              target="_blank"
              rel="noopener noreferrer"
              class="eco-item"
            >
              <div class="eco-item-icon">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="6" cy="6" r="3"></circle>
                  <circle cx="18" cy="18" r="3"></circle>
                  <circle cx="18" cy="6" r="3"></circle>
                  <line x1="8.5" y1="7.5" x2="15.5" y2="16.5"></line>
                  <line x1="8.5" y1="6" x2="15.5" y2="6"></line>
                </svg>
              </div>
              <div class="eco-item-text">
                <div class="eco-item-name">
                  <span>思维图谱</span>
                  <span class="eco-arrow-icon">↗</span>
                </div>
                <div class="eco-item-desc">概念经纬与网络</div>
              </div>
            </a>
            <a
              href={resolveSubdomain('https://ai.newmaybe.com')}
              target="_blank"
              rel="noopener noreferrer"
              class="eco-item"
            >
              <div class="eco-item-icon">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 22v-9"></path>
                  <path d="M12 13c0-4.5 3.5-7 8-7 0 4.5-2.5 8-7 8"></path>
                  <path d="M12 17c0-3-2.5-5-6-5 0 3 2 5 6 5"></path>
                </svg>
              </div>
              <div class="eco-item-text">
                <div class="eco-item-name">
                  <span>AI 园丁</span>
                  <span class="eco-arrow-icon">↗</span>
                </div>
                <div class="eco-item-desc">数字花园与问答</div>
              </div>
            </a>
            <a
              href={resolveSubdomain('https://study.newmaybe.com')}
              target="_blank"
              rel="noopener noreferrer"
              class="eco-item"
            >
              <div class="eco-item-icon">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                  <path d="M6 6h10"></path>
                  <path d="M6 10h10"></path>
                </svg>
              </div>
              <div class="eco-item-text">
                <div class="eco-item-name">
                  <span>林下书房</span>
                  <span class="eco-arrow-icon">↗</span>
                </div>
                <div class="eco-item-desc">古籍研习与写读</div>
              </div>
            </a>
            <a
              href={resolveSubdomain('https://studio.newmaybe.com')}
              target="_blank"
              rel="noopener noreferrer"
              class="eco-item"
            >
              <div class="eco-item-icon">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
                  <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
                  <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
                  <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
                  <path
                    d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2z"
                  ></path>
                </svg>
              </div>
              <div class="eco-item-text">
                <div class="eco-item-name">
                  <span>创作工坊</span>
                  <span class="eco-arrow-icon">↗</span>
                </div>
                <div class="eco-item-desc">排版卡片与海报</div>
              </div>
            </a>
            <a
              href={resolveSubdomain('https://club.newmaybe.com')}
              target="_blank"
              rel="noopener noreferrer"
              class="eco-item"
            >
              <div class="eco-item-icon">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
              </div>
              <div class="eco-item-text">
                <div class="eco-item-name">
                  <span>文友雅集</span>
                  <span class="eco-arrow-icon">↗</span>
                </div>
                <div class="eco-item-desc">文友共写与专题</div>
              </div>
            </a>
            <a
              href={resolveSubdomain('https://lab.newmaybe.com')}
              target="_blank"
              rel="noopener noreferrer"
              class="eco-item"
            >
              <div class="eco-item-icon">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M10 2v7.31a2 2 0 0 1-.37 1.17l-4.26 6.39A2 2 0 0 0 7 20h10a2 2 0 0 0 1.63-3.13l-4.26-6.39A2 2 0 0 1 14 9.31V2"
                  ></path>
                  <path d="M8.5 2h7"></path>
                  <path d="M14 9.3a6.5 6.5 0 1 1-4 0"></path>
                </svg>
              </div>
              <div class="eco-item-text">
                <div class="eco-item-name">
                  <span>实验室</span>
                  <span class="eco-arrow-icon">↗</span>
                </div>
                <div class="eco-item-desc">图形感知与声色</div>
              </div>
            </a>
          </div>
        </div>
      </li>
    </ul>

    <button class="search-nav-btn" id="search-nav-trigger" aria-label="搜索" title="搜索 (⌘K)">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="search-nav-icon"
      >
        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <kbd class="kbd-chip">⌘K</kbd>
    </button>
    <button class="theme-toggle" id="themeToggle" aria-label="切换主题" title="切换主题">
      <span class="mode-icon"></span>
    </button>
    <button class="menu-btn" aria-label="菜单" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: blur(6px);
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s ease;
  }
  header.scrolled {
    border-bottom: 1px solid var(--line);
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 72px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 2rem;
  }
  .logo {
    font-family: var(--serif-en);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .logo .dot {
    color: var(--ochre);
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .logo:hover .dot {
    transform: scale(1.4) translateY(-1px);
  }
  .nav-links {
    display: flex;
    gap: 2.4rem;
    list-style: none;
    margin-left: auto;
  }
  .nav-links a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.08em;
    position: relative;
    padding-bottom: 2px;
    transition: color 0.3s ease;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--ochre);
    transition: width 0.35s ease;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--ink);
  }
  .nav-links a.active {
    color: var(--ochre);
  }
  .nav-links a:hover::after,
  .nav-links a.active::after {
    width: 100%;
  }
  .nav-links a.active::after {
    background: var(--ochre);
  }

  /* 头部生态纯文字导航入口 */
  .nav-eco-li {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-eco-trigger {
    background: none;
    border: none;
    padding: 0 0 2px 0;
    margin: 0;
    font-family: inherit;
    font-size: 0.92rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    position: relative;
    transition: color 0.3s ease;
  }
  .nav-eco-trigger::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--ochre);
    transition: width 0.35s ease;
  }
  .nav-eco-trigger:hover,
  .nav-eco-trigger[aria-expanded='true'] {
    color: var(--ink);
  }
  .nav-eco-trigger:hover::after,
  .nav-eco-trigger[aria-expanded='true']::after {
    width: 100%;
  }
  .eco-caret {
    color: var(--ink-faint);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s ease;
  }
  .nav-eco-trigger:hover .eco-caret,
  .nav-eco-trigger[aria-expanded='true'] .eco-caret {
    color: var(--ochre);
  }
  .nav-eco-trigger[aria-expanded='true'] .eco-caret {
    transform: rotate(180deg);
  }

  /* 纸墨风微光下拉气泡卡片 */
  .eco-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    right: -24px;
    width: 320px;
    background: color-mix(in srgb, var(--paper) 94%, var(--paper-deep));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow:
      0 4px 16px rgba(43, 39, 34, 0.05),
      0 12px 32px rgba(43, 39, 34, 0.08);
    padding: 0.9rem 1rem;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 120;
  }
  :root.dark .eco-dropdown {
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.3),
      0 12px 36px rgba(0, 0, 0, 0.5);
  }
  .eco-dropdown.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* 顶部小三角 */
  .eco-dropdown::before {
    content: '';
    position: absolute;
    top: -5px;
    right: 34px;
    width: 8px;
    height: 8px;
    background: color-mix(in srgb, var(--paper) 94%, var(--paper-deep));
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
    transform: rotate(45deg);
  }

  .eco-dropdown-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    margin-bottom: 0.6rem;
    border-bottom: 1px dashed var(--line);
  }
  .eco-dropdown-title {
    font-family: var(--serif-cn);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .eco-dropdown-sub {
    font-family: var(--serif-en);
    font-style: italic;
    font-size: 0.72rem;
    color: var(--ochre);
  }
  .eco-dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem;
  }
  .eco-item {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    padding: 0.55rem 0.6rem;
    border-radius: 3px;
    background: transparent;
    border: 1px solid transparent;
    text-decoration: none;
    color: inherit;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .eco-item:hover {
    background: color-mix(in srgb, var(--ochre) 5%, transparent);
    border-color: color-mix(in srgb, var(--ochre) 25%, var(--line));
    transform: translateY(-1px);
  }
  .eco-item-icon {
    color: var(--ochre);
    opacity: 0.85;
    margin-top: 0.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .eco-item:hover .eco-item-icon {
    opacity: 1;
    transform: scale(1.1);
  }
  .eco-item-text {
    flex: 1;
    min-width: 0;
  }
  .eco-item-name {
    font-family: var(--serif-cn);
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.25s ease;
  }
  .eco-item:hover .eco-item-name {
    color: var(--ochre);
  }
  .eco-arrow-icon {
    font-family: var(--serif-en);
    font-size: 0.72rem;
    color: var(--ink-faint);
    opacity: 0.5;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      color 0.25s ease;
  }
  .eco-item:hover .eco-arrow-icon {
    opacity: 1;
    color: var(--ochre);
    transform: translate(1px, -1px);
  }
  .eco-item-desc {
    font-size: 0.69rem;
    color: var(--ink-faint);
    margin-top: 0.12rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .search-nav-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 2rem;
    color: var(--ink-soft);
    transition:
      color 0.3s ease,
      transform 0.2s ease;
  }
  .search-nav-btn:hover {
    color: var(--ink);
    transform: scale(1.05);
  }
  .search-nav-icon {
    width: 17px;
    height: 17px;
    color: var(--ink-soft);
  }
  .kbd-chip {
    display: inline-block;
    font-family: var(--serif-en);
    font-size: 0.68rem;
    color: var(--ink-faint);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.1rem 0.35rem;
    margin-left: 0.4rem;
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 2.4rem;
    transition: color 0.3s ease;
  }
  .theme-toggle .mode-icon {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-soft);
    background: linear-gradient(90deg, var(--ink-soft) 50%, transparent 50%);
    transition:
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s ease;
    transform-origin: center;
  }
  :root.dark .theme-toggle .mode-icon {
    border-color: var(--ink-soft);
    background: linear-gradient(90deg, var(--ink-soft) 50%, transparent 50%);
    transform: rotate(180deg);
  }
  .theme-toggle:hover .mode-icon {
    border-color: var(--ochre);
    background: linear-gradient(90deg, var(--ochre) 50%, transparent 50%);
    transform: rotate(180deg);
  }
  :root.dark .theme-toggle:hover .mode-icon {
    border-color: var(--ochre);
    background: linear-gradient(90deg, var(--ochre) 50%, transparent 50%);
    transform: rotate(0deg);
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    flex-shrink: 0;
  }
  .menu-btn span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
    transform-origin: center;
  }
  .menu-btn.open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .menu-btn.open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-btn.open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 680px) {
    .nav-links,
    .eco-nav-wrap {
      display: none;
    }
    .search-nav-btn {
      margin-left: auto;
      margin-right: 0.5rem;
    }
    .kbd-chip {
      display: none;
    }
    .theme-toggle {
      margin-left: 0;
      margin-right: 0.5rem;
    }
    .menu-btn {
      display: flex;
    }
  }
</style>
