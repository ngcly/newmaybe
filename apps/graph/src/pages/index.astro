---
import '@newmaybe/shared-styles/base.css';
import '../styles/graph.css';
import GraphHeader from '../components/GraphHeader.astro';
import GraphDetailCard from '../components/GraphDetailCard.astro';
import ThemeChrome from '@newmaybe/design-tokens/theme-chrome';

const isDev = import.meta.env.DEV;
const mainSiteUrl = isDev ? 'http://localhost:4321' : 'https://newmaybe.com';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <ThemeChrome />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>思考的经纬 · newmaybe 知识网络</title>
    <meta
      name="description"
      content="思考的经纬 - newmaybe 知识网络。一个可视化展示概念笔记、文章连接和念头关联的数字化双向链接知识图谱。"
    />
    <link rel="canonical" href="https://graph.newmaybe.com/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="思考的经纬 · newmaybe 知识网络" />
    <meta
      property="og:description"
      content="思考的经纬 - newmaybe 知识网络。一个可视化展示概念笔记、文章连接和念头关联的数字化双向链接知识图谱。"
    />
    <meta property="og:url" content="https://graph.newmaybe.com/" />
    <meta property="og:image" content="https://newmaybe.com/og-default.png" />
    <meta property="og:site_name" content="newmaybe" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="思考的经纬 · newmaybe 知识网络" />
    <meta
      name="twitter:description"
      content="思考的经纬 - newmaybe 知识网络。一个可视化展示概念笔记、文章连接和念头关联的数字化双向链接知识图谱。"
    />
    <meta name="twitter:image" content="https://newmaybe.com/og-default.png" />
  </head>
  <body>
    <!-- 用于传递环境变量给客户端 D3 脚本 -->
    <div id="subdomain-config" data-dev={isDev ? 'true' : 'false'} style="display: none;"></div>

    <!-- 控制台面板 -->
    <GraphHeader mainSiteUrl={mainSiteUrl} />

    <!-- 关系网图容器 -->
    <svg id="graph" role="group" aria-label="思考的经纬 - 知识图谱可视化" tabindex="0"></svg>

    <!-- ARIA live region 用于屏幕阅读器播报 -->
    <div id="aria-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    <!-- 浮动详情面板 -->
    <GraphDetailCard />

    <!-- D3 全局动态运行代码 -->
    <script src="../scripts/graph-app.ts"></script>
  </body>
</html>
