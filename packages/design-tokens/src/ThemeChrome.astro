---
import { dark, light } from './index';
import bootstrap from './theme-bootstrap';

const lightPaper = light.paper;
const darkPaper = dark.paper;
---

<meta
  name="theme-color"
  content={lightPaper}
  data-light={lightPaper}
  data-dark={darkPaper}
  media="(prefers-color-scheme: light)"
/>
<meta name="theme-color" content={darkPaper} media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<!-- Keep the closing script tag: the Astro ESLint processor requires it. -->
<!-- prettier-ignore -->
<script is:inline set:html={bootstrap}></script>
